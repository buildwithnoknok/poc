{
  "id": "light-meter-v1",
  "name": "Light Meter",
  "version": "1.0.0",
  "author": "buildwithnoknok",
  "brain_type": "pico_w",
  "price": 0.0,
  "setup_pattern": "Setup 1 (I2C only)",
  "description": "A light meter for photography and plants. An Adafruit VEML7700 light sensor measures lux; the display also shows the shutter speed that fits your aperture and ISO (incident-light estimate). Turn the knob to set aperture or ISO, press the LED Button to freeze a reading. Third-party Qwiic / Stemma QT board: plug it in with the brain off.",
  "modules_required": [
    {
      "type": "display",
      "count": 1
    },
    {
      "type": "knob",
      "count": 1
    },
    {
      "type": "led_button",
      "count": 1
    },
    {
      "type": "veml7700",
      "count": 1,
      "thirdparty": true
    }
  ],
  "module_firmware": {
    "display": {
      "min": "0.7.0"
    },
    "knob": {
      "min": "2.1.0"
    },
    "led_button": {
      "min": "2.1.0"
    }
  },
  "files": [
    {
      "dest": "product.py",
      "url": "https://raw.githubusercontent.com/buildwithnoknok/poc/main/scripts/light_meter.py",
      "version": "1.0.0",
      "required": true
    }
  ],
  "3d_files": [],
  "assembly_guide": [
    "Unplug the PicoHub first: third-party boards are connected with the brain off.",
    "Connect the Display, the Knob, the LED Button and the Adafruit VEML7700 to the PicoHub.",
    "Plug in the PicoHub and run setup in the noknok app. Hold the sensor where the light falls ON your subject."
  ],
  "controls": [
    {
      "control": "Knob turn",
      "action": "Change the highlighted (yellow) value: aperture f/1.4 to f/22, or ISO 50 to 1600"
    },
    {
      "control": "Knob press",
      "action": "Switch between aperture and ISO"
    },
    {
      "control": "LED Button press",
      "action": "Freeze / release the reading (button LED amber while frozen)"
    },
    {
      "control": "Hold a button or the knob while plugging in",
      "action": "Factory reset - keep holding until the LEDs flash / the buzzer confirms (about 8 s)"
    }
  ],
